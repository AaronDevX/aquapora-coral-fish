# Required in production. Generate with: npm run auth:hash -- "a-strong-password"
ADMIN_PASSWORD_HASH="replace-with-a-strong-password-or-scrypt-hash"
# Base32 secret imported into Google/Microsoft Authenticator.
ADMIN_TOTP_SECRET="JBSWY3DPEHPK3PXP"
# At least 32 random characters. Example: openssl rand -base64 48
AUTH_SECRET="replace-with-at-least-32-random-characters"
