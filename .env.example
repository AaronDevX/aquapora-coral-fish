# Server-only values. Copy service keys into .env.local, never into NEXT_PUBLIC_*.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Run npm run admin:setup to append these keys when absent.
# Do not copy example secrets. Existing invalid/empty auth values cause setup to fail.
# AUTH_SECRET: 32 random bytes, 64 hexadecimal characters.
# ADMIN_PASSWORD_HASH: scrypt hash; setup escapes $ for Next's dotenv expansion.
# ADMIN_TOTP_SECRET: random Base32 secret, imported with the local otpauth link.
# Hosting dashboards receive the literal hash, without .env backslash escaping.
